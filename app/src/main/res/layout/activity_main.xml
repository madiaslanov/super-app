<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <!-- Основной контент (линии, статус) слева -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/keyboard_container"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Верхняя панель: Статус и кнопки -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Подключено"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <!-- ИЗМЕНЕНИЕ: Добавлена кнопка Freeze -->
                <Button
                    android:id="@+id/freeze_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Замарозить" />

                <Button
                    android:id="@+id/toggle_keyboard_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Клавиатура" />

                <Button
                    android:id="@+id/reset_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Сброс" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Панель управления линией -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Линия"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/line_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Показать"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Объединенная линия -->
        <HorizontalScrollView
            android:id="@+id/line_scrollview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/line_background_merged"
            android:padding="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/combinedLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Поле для отображения вводимых чисел -->
        <TextView
            android:id="@+id/input_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            tools:text="12" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/keypad_container"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:padding="8dp"/>

</RelativeLayout>